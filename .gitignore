# Виртуальное окружение
venv/
.venv/

# Скомпилированный Python
__pycache__/
*.pyc

# База данных
instance/
*.db
*.sqlite3

# Переменные окружения — НИКОГДА не коммитить!
.env

# Редакторы
.vscode/
.idea/
.DS_Store
*.egg-info/
CLAUDE.md
.claude/

# Raw фото для seed (обрабатываются и кладутся в static/uploads/)
seed_images/*
!seed_images/.gitkeep

# Пользовательские загрузки (генерируются админкой / seed'ом)
app/static/uploads/*
!app/static/uploads/.gitkeep
